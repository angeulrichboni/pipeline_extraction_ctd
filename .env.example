# PubMed / NCBI (email recommandé, clé optionnelle)
NCBI_EMAIL=
NCBI_API_KEY=

# Endpoint LLM compatible OpenAI
ILAAS_API_KEY=
ILAAS_BASE_URL=https://llm.ilaas.fr/v1
ILAAS_MODEL=mistral-medium-latest
ILAAS_MAX_TOKENS=6144
ILAAS_TEMPERATURE=0

# Réseau et reprises
MAX_RETRIES=3
RETRY_SLEEP_SECONDS=3

# Récupération des textes complets
PAPERCLIP_BINARY=paperclip
PAPERCLIP_FULL_TEXT_PATH_TEMPLATE=/papers/{pmc_id}/content.lines

# Racine des données générées
CTD_DATA_ROOT=data/processed
